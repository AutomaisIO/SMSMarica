<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sem esta permissão o build de release não acessa a API (o debug a injeta sozinho). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Faixa "Sem conexão" (connectivity_plus). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Localização no dia da viagem (ADR-0082): só com o app aberto, depois do "Compartilhar". A
         aproximada vem junto porque o Android 12+ deixa a pessoa escolher. SEM segundo plano
         (ACCESS_BACKGROUND_LOCATION) e sem serviço em primeiro plano. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sem estas linhas, as permissões acima fazem a Play exigir GPS (android.hardware.location) e
         esconder o app de aparelho sem ele (a 1.0.2 perdeu 7). A localização é opcional: sem ela, o
         app funciona igual e a faixa diz que a localização está desligada. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Sem backup: o cache offline tem dados de saúde (perfil, exames, laudos em PDF) e não pode ir
         para o backup do Google nem passar de um aparelho para outro. allowBackup cobre o backup;
         dataExtractionRules cobre também a transferência entre aparelhos (Android 12+).
         networkSecurityConfig: release só aceita HTTPS e certificados do sistema. -->
    <application
        android:label="Saúde Maricá"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Links do WhatsApp (magic link e download do exame) abrem no app quando ele está
                 instalado; sem o app, seguem no PWA. A verificação automática (autoVerify)
                 exige publicar /.well-known/assetlinks.json em app.smsmarica.online com a
                 impressão digital da chave de assinatura do app — até lá o Android pergunta
                 "abrir com". -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.smsmarica.online" android:pathPrefix="/entrar/" />
                <data android:scheme="https" android:host="app.smsmarica.online" android:pathPrefix="/documento/" />
            </intent-filter>
        </activity>
        <!-- go_router recebe o link e abre a rota equivalente à do PWA. -->
        <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
        <!-- O geolocator declara o seu serviço como "primeiro plano de localização" (para quem rastreia
             com o app fechado). Este app não faz isso (ADR-0082 §3): o serviço fica (sem ele o fluxo de
             posições NÃO começa — "Location background service has not started correctly"), mas sem o
             tipo. Ele só é vinculado, nunca vai para o primeiro plano (o app não passa
             foregroundNotificationConfig), e a Play não pede a declaração de serviço em primeiro plano. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:remove="android:foregroundServiceType" />
        <!-- Push (Firebase) com o app fechado: o sistema mostra o aviso sozinho, com este canal,
             o ícone pequeno (branco; o Android só usa o contorno) e a cor da marca. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notificacao" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificacao" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: abrir o WhatsApp (wa.me) e as páginas de privacidade/termos. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
