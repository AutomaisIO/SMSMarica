<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para o backup na nuvem nem para a transferência entre aparelhos.
     O cache offline guarda dados de saúde do cidadão (perfil, exames, laudos em PDF) e a sessão; no
     aparelho novo a pessoa entra de novo com CPF + data de nascimento + código. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
