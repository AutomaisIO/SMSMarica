# Credenciais do laboratório Klinikos (Eco Sistemas, ASP.NET WebForms).
# Copie para .env e preencha. O .env é gitignored (credencial).
# Use um usuário só do laboratório: logar de novo pode derrubar a sessão web do mesmo usuário.

KLINIKOS_BASE=https://klinikosconde.smsmarica.online
KLINIKOS_USUARIO=
KLINIKOS_SENHA=
# Sessão do navegador do operador (valor de ASP.NET_SessionId, DevTools > Application > Cookies).
# Se preenchido, o cliente ADOTA essa sessão e NÃO faz login (não derruba a janela).
KLINIKOS_COOKIE=
