@page "/admin/entrar"
@model Automais.Zap.Api.Pages.Admin.EntrarModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_Layout";
}

<div class="cartao" style="max-width:360px;margin:12vh auto 0">
    <h1>automais<span style="color:var(--marca)">.zap</span></h1>
    <p class="sub">Roteador de webhook do WhatsApp.</p>

    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="aviso">@Model.Erro</div>
    }

    <form method="post">
        <div style="margin-bottom:12px">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="Email" value="@Model.Email" required autofocus style="width:100%" />
        </div>
        <div style="margin-bottom:16px">
            <label for="senha">Senha</label>
            <input type="password" id="senha" name="Senha" required style="width:100%" />
        </div>
        <button class="acao" type="submit" style="width:100%">Entrar</button>
    </form>
</div>
