@page "/admin/waba"
@model Automais.Zap.Api.Pages.Admin.WabaModel
@{
    ViewData["Title"] = Model.Alvo?.Nome ?? "WABA";
}

@if (Model.Alvo is null)
{
    <div class="cartao vazio">WABA não encontrado.</div>
    return;
}

<p class="migalhas">
    <a href="/admin/tenant?id=@Model.Alvo.TenantId">Painel</a>
    <span class="sep">/</span>
    <span>@(Model.Alvo.Nome ?? Model.Alvo.WabaId)</span>
</p>

<div class="pagina-topo" style="margin-bottom:8px">
    <div>
        <h1>@(Model.Alvo.Nome ?? Model.Alvo.WabaId)</h1>
        <p class="sub compacto">Conta WhatsApp Business · ID na Meta: <code>@Model.Alvo.WabaId</code></p>
    </div>
    <div class="acoes">
        <a class="discreto" style="padding:7px 13px;border-radius:8px;border:1px solid var(--campo-borda);font-size:12.5px;font-weight:600" href="/admin/templates?id=@Model.Alvo.Id">Templates</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}
@if (!string.IsNullOrEmpty(Model.Recado))
{
    <div class="aviso ok">@Model.Recado</div>
}

@{
    var temDestino = !string.IsNullOrWhiteSpace(Model.Alvo.UrlDestino);
    var temNumeroAtivo = Model.Numeros.Any(n => n.Ativo);
    var tudoOk = Model.EsteAppInscrito && Model.TemSegredo && temDestino && Model.Alvo.RoteamentoAtivo && temNumeroAtivo && Model.TenantAtivo;
}

<h2 style="margin-top:18px">Rota de entrega</h2>
<div class="cartao">
    @if (tudoOk)
    {
        <p class="sub"><span class="selo on">canal completo</span> Cada evento da Meta percorre esta rota até o seu sistema.</p>
    }
    else
    {
        <p class="sub"><span class="selo atencao">rota incompleta</span> As estações em vermelho impedem os eventos de chegar ao destino.</p>
    }
    <ul class="rota">
        <li class="@(Model.EsteAppInscrito ? "ok" : (Model.ErroGraph is null ? "falha" : "pendente"))">
            <span class="no"><span class="ponto"></span></span>
            <span class="estacao">
                <span class="titulo">Meta envia os eventos deste WABA
                    <span class="selo @(Model.EsteAppInscrito ? "on" : (Model.ErroGraph is null ? "off" : "atencao"))">@(Model.EsteAppInscrito ? "App inscrito" : (Model.ErroGraph is null ? "App não inscrito" : "não confirmado"))</span>
                </span>
                <span class="detalhe">
                    @if (Model.ErroGraph is not null)
                    {
                        <span>A Meta não respondeu agora: @Model.ErroGraph</span>
                    }
                    else if (Model.EsteAppInscrito)
                    {
                        <span>O App da Automais está inscrito — a Meta entrega os eventos no webhook da plataforma.</span>
                    }
                    else
                    {
                        <span>Enquanto o App da Automais não estiver inscrito, a Meta não manda nada para cá.</span>
                    }
                </span>
            </span>
        </li>
        <li class="@(Model.TemSegredo ? "ok" : "falha")">
            <span class="no"><span class="ponto"></span></span>
            <span class="estacao">
                <span class="titulo">Plataforma assina a entrega
                    <span class="selo @(Model.TemSegredo ? "on" : "off")">@(Model.TemSegredo ? "segredo ok" : "sem segredo")</span>
                </span>
                <span class="detalhe">Assinatura própria em <code>X-Automais-Signature</code>; o destino confere com o mesmo segredo.</span>
            </span>
        </li>
        <li class="@(temDestino && Model.Alvo.RoteamentoAtivo ? "ok" : "falha")">
            <span class="no"><span class="ponto"></span></span>
            <span class="estacao">
                <span class="titulo">Roteamento até o destino
                    <span class="selo @(Model.Alvo.RoteamentoAtivo ? "on" : "off")">@(Model.Alvo.RoteamentoAtivo ? "ligado" : "desligado")</span>
                    <span class="selo @(temDestino ? "on" : "off")">@(temDestino ? "destino ok" : "sem destino")</span>
                </span>
                <span class="detalhe">@(Model.Alvo.UrlDestino ?? "Nenhum webhook de destino configurado.")</span>
            </span>
        </li>
        <li class="@(temNumeroAtivo && Model.TenantAtivo ? "ok" : "falha")">
            <span class="no"><span class="ponto"></span></span>
            <span class="estacao">
                <span class="titulo">Sistema do cliente recebe
                    <span class="selo @(temNumeroAtivo ? "on" : "off")">@(temNumeroAtivo ? $"{Model.Numeros.Count(n => n.Ativo)} número(s) ativo(s)" : "nenhum número ativo")</span>
                    <span class="selo @(Model.TenantAtivo ? "on" : "off")">@(Model.TenantAtivo ? "cliente ativo" : "cliente suspenso")</span>
                </span>
                <span class="detalhe">Prova final: uma mensagem real entrando e um envio recebendo <code>delivered</code> em <a href="/admin/entregas">Entregas</a>.</span>
            </span>
        </li>
    </ul>
</div>

<h2>Roteamento</h2>
<div class="cartao">
    <form method="post" asp-page-handler="Roteamento" class="linha" style="margin-top:0">
        <input type="hidden" name="id" value="@Model.Alvo.Id" />
        <div style="flex:1;min-width:340px">
            <label for="waba-destino">Webhook da aplicação de destino</label>
            <input id="waba-destino" type="url" name="urlDestino" value="@Model.Alvo.UrlDestino" style="width:100%"
                   placeholder="https://api.dominio-do-cliente/integracoes/whatsapp/webhook" />
        </div>
        <div>
            <label for="waba-entregar">Entregar</label>
            <select id="waba-entregar" name="ativo">
                <option value="true" selected="@Model.Alvo.RoteamentoAtivo">ligado</option>
                <option value="false" selected="@(!Model.Alvo.RoteamentoAtivo)">desligado</option>
            </select>
        </div>
        <button class="acao" type="submit">Salvar</button>
    </form>
    <p class="ajuda-campo" style="margin:12px 0 0">Todos os números deste WABA herdam esse destino (um número pode ter exceção, abaixo).</p>
</div>

<h2>Assinatura da entrega</h2>
<div class="cartao">
    @if (!string.IsNullOrEmpty(Model.SegredoNovo))
    {
        <div class="aviso ok">
            <strong>Segredo gerado — copie agora.</strong> Não é exibido de novo. Cole em Integrações → WhatsApp → "Segredo do webhook" no sistema de destino.
            <div class="segredo-linha">
                <code class="copiavel" id="segredo-novo">@Model.SegredoNovo</code>
                <button type="button" class="acao discreto" data-copiar="#segredo-novo">Copiar</button>
            </div>
        </div>
    }

    @if (Model.TemSegredo)
    {
        <p class="sub" style="margin:0 0 12px">
            <span class="selo on">segredo configurado</span>
            As entregas saem assinadas em <code>X-Automais-Signature</code> (com <code>X-Automais-Timestamp</code>);
            o destino confere com o mesmo segredo.
        </p>
        <form method="post" asp-page-handler="GerarSegredo" style="display:inline"
              onsubmit="return confirm('Gerar um novo segredo? O destino recusa tudo com 401 até ser reconfigurado com o valor novo.');">
            <input type="hidden" name="id" value="@Model.Alvo.Id" />
            <button class="acao discreto" type="submit">Gerar outro</button>
        </form>
        <form method="post" asp-page-handler="RemoverSegredo" style="display:inline"
              onsubmit="return confirm('Remover o segredo? O roteamento deste WABA é DESLIGADO junto — sem assinatura o destino recusaria tudo. Gere um novo e religue quando configurar.');">
            <input type="hidden" name="id" value="@Model.Alvo.Id" />
            <button class="acao perigo" type="submit">Remover segredo</button>
        </form>
    }
    else
    {
        <p class="sub" style="margin:0 0 12px">
            <span class="selo off">sem segredo</span>
            Sem segredo próprio a entrega sai sem <code>X-Automais-Signature</code> e o destino recusa com 401.
            O roteamento não pode ser ligado até gerar um.
        </p>
        <form method="post" asp-page-handler="GerarSegredo">
            <input type="hidden" name="id" value="@Model.Alvo.Id" />
            <button class="acao" type="submit">Gerar segredo próprio</button>
        </form>
    }
</div>

<h2>Quem recebe os eventos deste WABA</h2>
<div class="cartao">
    @if (Model.ErroGraph is not null)
    {
        <div class="aviso atencao">Não foi possível consultar a Meta: @Model.ErroGraph. Os dados abaixo podem estar desatualizados.</div>
    }

    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        @if (Model.EsteAppInscrito)
        {
            <span class="selo on">recebendo</span> <span class="sub compacto">o App da Automais está inscrito neste WABA</span>
        }
        else
        {
            <span class="selo off">não recebendo</span> <span class="sub compacto">o App da Automais ainda não está inscrito neste WABA</span>
        }

        @if (Model.Global)
        {
            <form method="post" asp-page-handler="@(Model.EsteAppInscrito ? "Desinscrever" : "Inscrever")" style="margin-left:auto"
                  onsubmit="return confirm('@(Model.EsteAppInscrito ? "Desinscrever? Este WABA PARA de entregar eventos aqui na hora." : "Inscrever? A partir daí a Meta entrega os eventos deste WABA no nosso webhook.")');">
                <input type="hidden" name="id" value="@Model.Alvo.Id" />
                <button class="acao @(Model.EsteAppInscrito ? "discreto" : "")" type="submit">
                    @(Model.EsteAppInscrito ? "Parar de receber" : "Passar a receber")
                </button>
            </form>
        }
    </div>

    @if (Model.OutrosApps.Any())
    {
        <div class="aviso" style="margin-top:14px">
            <strong>Integração antiga ainda ativa.</strong> Estes Apps também recebem os eventos
            deste WABA — o que significa que parte do tráfego continua indo para o sistema anterior:
            <ul style="margin:8px 0 0">
                @foreach (var a in Model.OutrosApps)
                {
                    <li>@(a.Nome ?? "(sem nome)") — <code>@a.Id</code></li>
                }
            </ul>
        </div>
    }
    else if (Model.EsteAppInscrito)
    {
        <p class="sub" style="margin:12px 0 0">Só o App da Automais recebe os eventos deste WABA.</p>
    }
</div>

<h2>Números <span class="cont">@Model.Numeros.Count</span></h2>
<div class="cartao">
    <div style="display:flex;align-items:center;gap:12px">
        <span class="sub compacto">
            @if (Model.Alvo.SincronizadoEm is not null)
            {
                <span>Sincronizado em @Model.Alvo.SincronizadoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            }
            else
            {
                <span>Nunca sincronizado.</span>
            }
        </span>
        <form method="post" asp-page-handler="Sincronizar" style="margin-left:auto">
            <input type="hidden" name="id" value="@Model.Alvo.Id" />
            <button class="acao discreto" type="submit">Sincronizar com a Meta</button>
        </form>
    </div>

    <table style="margin-top:12px">
        <thead>
        <tr><th>Número</th><th>Rótulo</th><th>ID do número (Meta)</th><th>Destino próprio (opcional)</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var n in Model.Numeros)
        {
            <tr>
                <td><a href="/admin/numero?id=@n.Id" class="num" style="font-weight:500">@(n.DisplayPhoneNumber ?? n.PhoneNumberId)</a></td>
                <td>@(n.Rotulo ?? "—")</td>
                <td class="num"><code>@n.PhoneNumberId</code></td>
                <td>
                    <form method="post" asp-page-handler="Override" style="display:flex;gap:6px">
                        <input type="hidden" name="id" value="@Model.Alvo.Id" />
                        <input type="hidden" name="numeroId" value="@n.Id" />
                        <input type="url" name="url" value="@n.UrlDestinoOverride" placeholder="herda do WABA" style="min-width:220px" aria-label="Destino próprio do número @(n.DisplayPhoneNumber ?? n.PhoneNumberId)" />
                        <button class="acao discreto" type="submit">Salvar</button>
                    </form>
                </td>
                <td><span class="selo @(n.Ativo ? "on" : "off")">@(n.Ativo ? "ativo" : "desligado")</span></td>
                <td class="acoes">
                    <form method="post" asp-page-handler="AlternarNumero" style="display:inline"
                          onsubmit="return confirm('@(n.Ativo ? "Desligar este número? Os eventos dele param de ser entregues." : "Ligar este número?")');">
                        <input type="hidden" name="id" value="@Model.Alvo.Id" />
                        <input type="hidden" name="numeroId" value="@n.Id" />
                        <button class="acao @(n.Ativo ? "perigo" : "discreto")" type="submit">@(n.Ativo ? "Desligar" : "Ligar")</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Numeros.Count == 0)
        {
            <tr><td colspan="6" class="sub compacto" style="text-align:center;padding:16px">Nenhum número ainda. Use "Sincronizar com a Meta" para trazer os números deste WABA.</td></tr>
        }
        </tbody>
    </table>
</div>
