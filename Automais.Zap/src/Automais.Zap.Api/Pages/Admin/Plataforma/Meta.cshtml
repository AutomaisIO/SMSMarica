@page "/admin/meta"
@model Automais.Zap.Api.Pages.Admin.Plataforma.MetaModel
@{
    ViewData["Title"] = "App da Meta";
}

<div class="pagina-topo">
    <div>
        <h1>App da Meta</h1>
        <p class="sub compacto">
            Configuração global da plataforma — vale para todos os clientes desta instância.
            Credenciais do App e para onde a Meta entrega os eventos.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}
@if (!string.IsNullOrEmpty(Model.Recado))
{
    <div class="aviso ok">@Model.Recado</div>
}

<div class="grade-resumo">
    <div class="resumo @(string.IsNullOrEmpty(Model.AppId) ? "alerta" : "ok")">
        <div class="valor" style="font-size:18px">@(string.IsNullOrEmpty(Model.AppId) ? "falta" : "ok")</div>
        <div class="rotulo">App ID</div>
    </div>
    <div class="resumo @(Model.TemAppSecret ? "ok" : "alerta")">
        <div class="valor" style="font-size:18px">@(Model.TemAppSecret ? "ok" : "falta")</div>
        <div class="rotulo">App Secret</div>
    </div>
    <div class="resumo @(Model.TemVerifyToken ? "ok" : "alerta")">
        <div class="valor" style="font-size:18px">@(Model.TemVerifyToken ? "ok" : "falta")</div>
        <div class="rotulo">Verify token</div>
    </div>
    <div class="resumo @(Model.TemTokenSistema ? "ok" : "alerta")">
        <div class="valor" style="font-size:18px">@(Model.TemTokenSistema ? "ok" : "falta")</div>
        <div class="rotulo">Token do System User</div>
    </div>
</div>

<h2>Webhook do App</h2>
<div class="cartao">
    @if (Model.ErroGraph is not null)
    {
        <div class="aviso atencao">Não foi possível consultar a Meta: @Model.ErroGraph</div>
    }
    else if (Model.Assinaturas.Count == 0)
    {
        <p class="sub" style="margin:0 0 12px">
            Nenhum webhook configurado neste App. Enquanto não houver, a Meta não entrega evento
            nenhum — mesmo com o WABA inscrito.
        </p>
    }
    else
    {
        <table>
            <thead><tr><th>Objeto</th><th>Callback URL</th><th>Campos</th><th>Ativo</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Assinaturas)
            {
                <tr>
                    <td>@a.Objeto</td>
                    <td><code>@(a.CallbackUrl ?? "—")</code></td>
                    <td class="sub compacto">@string.Join(", ", a.Campos)</td>
                    <td><span class="selo @(a.Ativo ? "on" : "off")">@(a.Ativo ? "sim" : "não")</span></td>
                </tr>
            }
            </tbody>
        </table>
    }

    <form method="post" asp-page-handler="ConfigurarWebhook" class="linha">
        <div style="flex:1;min-width:340px">
            <label for="meta-url">Callback URL (esta instância da plataforma)</label>
            <input id="meta-url" type="url" name="urlWebhook" value="@Model.UrlWebhookSugerida" required style="width:100%" />
        </div>
        <button class="acao" type="submit">Apontar o App para cá</button>
    </form>
    <p class="ajuda-campo" style="margin:10px 0 0">
        Campos assinados:
        @foreach (var campo in Automais.Zap.Api.Pages.Admin.Plataforma.MetaModel.CamposWebhook)
        {
            <code>@campo</code>
        }
        A Meta chama a URL com o verify token antes de aceitar — se a plataforma estiver fora do ar, ela recusa.
    </p>
</div>

<h2>Credenciais</h2>
<div class="cartao">
    <p class="sub" style="margin:0 0 4px">
        Segredos nunca são exibidos de volta. Nos três campos de segredo, deixar em branco
        mantém o valor atual e digitar <code>-</code> apaga.
    </p>
    <form method="post" asp-page-handler="Salvar" class="linha">
        <div>
            <label for="meta-appid">App ID</label>
            <input id="meta-appid" type="text" name="appId" value="@Model.AppId" class="num" />
        </div>
        <div>
            <label for="meta-appsecret">App Secret <span class="selo @(Model.TemAppSecret ? "on" : "off")" style="margin-left:4px">@(Model.TemAppSecret ? "configurado" : "faltando")</span></label>
            <input id="meta-appsecret" type="password" name="appSecret" autocomplete="new-password" />
        </div>
        <div>
            <label for="meta-verify">Verify token <span class="selo @(Model.TemVerifyToken ? "on" : "off")" style="margin-left:4px">@(Model.TemVerifyToken ? "configurado" : "faltando")</span></label>
            <input id="meta-verify" type="password" name="verifyToken" autocomplete="new-password" />
        </div>
        <div>
            <label for="meta-token">Token do System User <span class="selo @(Model.TemTokenSistema ? "on" : "off")" style="margin-left:4px">@(Model.TemTokenSistema ? "configurado" : "faltando")</span></label>
            <input id="meta-token" type="password" name="tokenSistema" autocomplete="new-password" />
        </div>
        <div>
            <label for="meta-baseurl">Graph API</label>
            <input id="meta-baseurl" type="url" name="baseUrl" value="@Model.BaseUrl" class="num" style="min-width:260px" />
        </div>
        <button class="acao" type="submit">Salvar</button>
    </form>

    <p class="sub" style="margin:14px 0 0">
        <strong>App Secret</strong> valida a assinatura de cada evento recebido — sem ele o
        webhook responde 503, de propósito.
        <strong>Token do System User</strong> serve para a gestão (WABAs, templates, perfil,
        métricas); a plataforma nunca o usa para enviar mensagem.
    </p>
</div>
