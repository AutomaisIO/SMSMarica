@page "/admin/tenant"
@model Automais.Zap.Api.Pages.Admin.TenantModel
@{
    ViewData["Title"] = "Painel";
}

@if (Model.Alvo is null)
{
    <div class="cartao vazio">Cliente não encontrado.</div>
    return;
}

@section Head {
    <style>
        .grade-wabas { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
        .waba-cartao { display: flex; flex-direction: column; gap: 10px; overflow: hidden; }
        .waba-cartao .cabeca { display: flex; align-items: center; gap: 10px; }
        .waba-cartao .cabeca .nome { font: 600 15px var(--fonte-titulo); letter-spacing: -0.01em; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .waba-cartao .cabeca .selo { margin-left: auto; }
        .waba-cartao .id { font-size: 12px; color: var(--fraco); }
        .waba-cartao .destino { font-size: 12.5px; color: var(--suave); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .waba-cartao .saude { display: flex; gap: 6px; flex-wrap: wrap; }
        .waba-cartao .pe { display: flex; gap: 8px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--borda-suave); }
        .waba-cartao .pe a {
            font-weight: 600; font-size: 12.5px; padding: 6px 12px; border-radius: 8px;
            border: 1px solid var(--campo-borda); color: var(--suave);
        }
        .waba-cartao .pe a:hover { text-decoration: none; color: var(--texto); border-color: var(--suave); }
        .waba-cartao .pe a.principal { color: #fff; background: var(--ciano); border-color: var(--ciano); }
        .waba-cartao .pe a.principal:hover { background: var(--ciano-forte); }
    </style>
}

<div class="pagina-topo">
    <div>
        <h1>@Model.Alvo.Nome</h1>
        <p class="sub compacto">
            @if (Model.Alvo.SuspensoEm is not null)
            {
                <span class="selo off">canal suspenso</span>
            }
            else
            {
                <span class="selo on">canal ativo</span>
            }
            @if (!string.IsNullOrEmpty(Model.Alvo.Observacao))
            {
                <span> · @Model.Alvo.Observacao</span>
            }
        </p>
    </div>
    @if (Model.Global)
    {
        <form method="post" asp-page-handler="Suspender" class="acoes" style="margin:0">
            <input type="hidden" name="id" value="@Model.Alvo.Id" />
            @if (Model.Alvo.SuspensoEm is null)
            {
                <input type="text" name="motivo" placeholder="motivo (opcional)" aria-label="Motivo da suspensão" style="min-width:200px" />
                <button class="acao perigo" type="submit"
                        onclick="return confirm('Suspender o canal deste cliente? Todos os WABAs param de receber e os tokens param de enviar, na hora.');">Suspender canal</button>
            }
            else
            {
                <button class="acao" type="submit">Religar canal</button>
            }
        </form>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}
@if (!string.IsNullOrEmpty(Model.Recado))
{
    <div class="aviso ok">@Model.Recado</div>
}

<div class="grade-resumo">
    <div class="resumo">
        <div class="valor">@Model.Wabas.Count</div>
        <div class="rotulo">conta@(Model.Wabas.Count == 1 ? "" : "s") WhatsApp Business</div>
    </div>
    <div class="resumo">
        <div class="valor">@Model.NumerosAtivos<span class="fraco">/@Model.NumerosTotal</span></div>
        <div class="rotulo"><a href="/admin/numeros">número@(Model.NumerosTotal == 1 ? "" : "s") ativo@(Model.NumerosAtivos == 1 ? "" : "s")</a></div>
    </div>
    <div class="resumo ok">
        <div class="valor">@Model.Entregues24h.ToString("N0", new System.Globalization.CultureInfo("pt-BR"))</div>
        <div class="rotulo"><a href="/admin/entregas?tenant=@Model.Alvo.Id">entregas em 24h</a></div>
    </div>
    <div class="resumo @(Model.FalhasUltimas24h > 0 ? "alerta" : "")">
        <div class="valor">@Model.FalhasUltimas24h</div>
        <div class="rotulo"><a href="/admin/entregas?tenant=@Model.Alvo.Id&falhas=true">falha@(Model.FalhasUltimas24h == 1 ? "" : "s") em 24h</a></div>
    </div>
    <div class="resumo">
        <div class="valor">@Model.TokensAtivos</div>
        <div class="rotulo"><a href="/admin/tokens">token@(Model.TokensAtivos == 1 ? "" : "s") de API</a></div>
    </div>
</div>

@if (Model.Wabas.Count == 0)
{
    <h2>Como o canal entra no ar</h2>
    <div class="cartao">
        <p class="sub">
            Nenhuma conta WhatsApp Business vinculada ainda. O caminho até a primeira mensagem:
        </p>
        <ul class="rota">
            <li class="pendente">
                <span class="no"><span class="ponto"></span></span>
                <span class="estacao">
                    <span class="titulo">Vincular o WABA</span>
                    <span class="detalhe">A Automais valida o ID da conta WhatsApp Business direto na Meta e a vincula a este cliente.</span>
                </span>
            </li>
            <li class="pendente">
                <span class="no"><span class="ponto"></span></span>
                <span class="estacao">
                    <span class="titulo">Gerar o segredo de entrega</span>
                    <span class="detalhe">Cada evento passa a sair assinado — o sistema de destino confere a assinatura antes de aceitar.</span>
                </span>
            </li>
            <li class="pendente">
                <span class="no"><span class="ponto"></span></span>
                <span class="estacao">
                    <span class="titulo">Apontar o destino e ligar o roteamento</span>
                    <span class="detalhe">O webhook do seu sistema recebe os eventos de todos os números do WABA.</span>
                </span>
            </li>
            <li class="pendente">
                <span class="no"><span class="ponto"></span></span>
                <span class="estacao">
                    <span class="titulo">Inscrever o App da Automais no WABA</span>
                    <span class="detalhe">A partir daí a Meta entrega os eventos aqui — e o painel mostra tudo em <a href="/admin/entregas">Entregas</a>.</span>
                </span>
            </li>
        </ul>
        @if (!Model.Global)
        {
            <p class="sub compacto" style="margin-top:16px">Fale com a Automais para vincular a primeira conta.</p>
        }
    </div>
}
else
{
    <h2>Contas WhatsApp Business <span class="cont">@Model.Wabas.Count</span></h2>
    <div class="grade-wabas">
        @foreach (var w in Model.Wabas)
        {
            var temSegredo = !string.IsNullOrEmpty(w.SegredoEntregaCifrado);
            var temDestino = !string.IsNullOrWhiteSpace(w.UrlDestino);
            <div class="cartao waba-cartao">
                <div class="cabeca">
                    <span class="nome">@(w.Nome ?? "(sem nome)")</span>
                    <span class="selo @(w.RoteamentoAtivo ? "on" : "off")">@(w.RoteamentoAtivo ? "roteando" : "parado")</span>
                </div>
                <div class="id">ID na Meta: <code>@w.WabaId</code></div>
                <div class="destino" title="@(w.UrlDestino ?? "")">
                    Destino: @(temDestino ? w.UrlDestino : "— não configurado")
                </div>
                <div class="saude">
                    <span class="selo @(w.Numeros.Any(n => n.Ativo) ? "on" : "off")">@w.Numeros.Count número@(w.Numeros.Count == 1 ? "" : "s")</span>
                    <span class="selo @(temDestino ? "on" : "off")">destino</span>
                    <span class="selo @(temSegredo ? "on" : "off")">segredo</span>
                </div>
                <div class="pe">
                    <a class="principal" href="/admin/waba?id=@w.Id">Abrir</a>
                    <a href="/admin/templates?id=@w.Id">Templates</a>
                </div>
            </div>
        }
    </div>
}

@if (Model.Global)
{
    <details class="adicionar">
        <summary>Vincular WABA</summary>
        <div class="cartao">
            <form method="post" asp-page-handler="AdicionarWaba" class="linha" style="margin-top:0">
                <input type="hidden" name="id" value="@Model.Alvo.Id" />
                <div>
                    <label for="waba-id">ID do WABA na Meta</label>
                    <input id="waba-id" type="text" name="wabaId" required placeholder="1234567890123456" class="num" />
                </div>
                <button class="acao" type="submit">Vincular</button>
            </form>
            <p class="ajuda-campo" style="margin-top:10px">A plataforma consulta a Meta antes de gravar: ID errado não vira linha órfã.</p>
        </div>
    </details>
}
