@page "/admin/entregas"
@model Automais.Zap.Api.Pages.Admin.EntregasModel
@{
    ViewData["Title"] = "Entregas";
}

<h1>Entregas</h1>
<p class="sub">
    Trilha operacional do relay. Não há corpo de mensagem, wamid nem telefone de cidadão aqui —
    só a linha nossa, o tipo do evento e o resultado.
</p>

<div class="grade-resumo">
    <div class="resumo ok"><div class="valor">@Model.Entregues24h</div><div class="rotulo">entregues em 24h</div></div>
    <div class="resumo @(Model.Falhas24h > 0 ? "alerta" : "")"><div class="valor">@Model.Falhas24h</div><div class="rotulo">falhas em 24h</div></div>
    <div class="resumo @(Model.SemRota24h > 0 ? "alerta" : "")"><div class="valor">@Model.SemRota24h</div><div class="rotulo">sem rota em 24h</div></div>
</div>

@if (Model.SemRota24h > 0)
{
    <div class="aviso atencao">
        Eventos chegaram de números que não estão roteados. Confira o <code>phone_number_id</code>
        na tela do WABA e sincronize com a Meta.
    </div>
}

<div class="cartao">
    <form method="get" class="linha" style="margin:0 0 12px">
        @if (Model.Tenants.Count > 1)
        {
            <div>
                <label for="f-tenant">Tenant</label>
                <select id="f-tenant" name="tenant" class="campo">
                    <option value="">todos</option>
                    @foreach (var t in Model.Tenants)
                    {
                        <option value="@t.Id" selected="@(Model.Tenant == t.Id)">@t.Nome</option>
                    }
                </select>
            </div>
        }
        <div>
            <label for="f-tipo">Tipo</label>
            <select id="f-tipo" name="tipo" class="campo">
                <option value="">todos</option>
                <option value="messages" selected="@(Model.Tipo == "messages")">messages (recebido)</option>
                <option value="envio" selected="@(Model.Tipo == "envio")">envio</option>
                <option value="message_template_status_update" selected="@(Model.Tipo == "message_template_status_update")">status de template</option>
            </select>
        </div>
        <label class="opcao" style="margin:0 0 9px"><input type="checkbox" name="falhas" value="true" checked="@Model.Falhas" /> só falhas</label>
        <button class="acao discreto" type="submit">Filtrar</button>
        @if (Model.Tenant is not null || !string.IsNullOrWhiteSpace(Model.Tipo) || Model.Falhas)
        {
            <a href="/admin/entregas" class="sub compacto" style="align-self:center">limpar</a>
        }
    </form>

    <table>
        <thead>
        <tr>
            <th>Quando</th>
            <th>Tenant</th>
            <th>Linha</th>
            <th>Tipo</th>
            <th>HTTP</th>
            <th>ms</th>
            <th>Erro</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Linhas)
        {
            <tr>
                <td class="num">@l.RecebidoEm.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                <td>@(l.Tenant ?? "—")</td>
                <td class="num"><code>@l.PhoneNumberId</code></td>
                <td>@l.Tipo</td>
                <td class="num"><span class="selo @(l.Sucesso ? "on" : "off")">@(l.StatusHttp?.ToString() ?? "—")</span></td>
                <td class="num">@l.DuracaoMs</td>
                <td class="sub compacto">@(l.Erro ?? "")</td>
            </tr>
        }
        @if (Model.Linhas.Count == 0)
        {
            <tr><td colspan="7" class="sub compacto" style="text-align:center;padding:20px">Nada com esses filtros.</td></tr>
        }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <div style="display:flex;gap:8px;align-items:center;justify-content:flex-end;margin-top:12px" class="sub compacto">
            <span>@Model.Total registro@(Model.Total == 1 ? "" : "s") · página @Model.PaginaAtual de @Model.TotalPaginas</span>
            @if (Model.PaginaAtual > 1)
            {
                <a href="@Model.UrlPagina(Model.PaginaAtual - 1)">‹ anterior</a>
            }
            @if (Model.PaginaAtual < Model.TotalPaginas)
            {
                <a href="@Model.UrlPagina(Model.PaginaAtual + 1)">próxima ›</a>
            }
        </div>
    }
</div>
