@page "/admin"
@model Automais.Zap.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Painel";
}

<h1>Nenhum tenant</h1>
<p class="sub">&nbsp;</p>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}

<div class="cartao vazio">
    @if (Model.Global)
    {
        <span>Ainda não há nenhum cliente cadastrado.</span>
        <div style="margin-top:14px"><a class="acao" href="/admin/novo" style="display:inline-block;text-decoration:none;background:var(--marca);color:var(--marca-escura);border-radius:7px;padding:9px 14px;font-weight:600">Criar o primeiro cliente</a></div>
    }
    else
    {
        <span>Você não está atribuído a nenhum tenant. Peça a quem administra a plataforma para incluir seu acesso.</span>
    }
</div>
