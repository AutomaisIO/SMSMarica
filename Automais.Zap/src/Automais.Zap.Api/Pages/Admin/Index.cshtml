@page "/admin"
@model Automais.Zap.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Início";
}

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}

<div class="cartao vazio" style="max-width:560px;margin:10vh auto 0;padding:44px 32px">
    <img src="/marca/cruz.svg" alt="" style="width:52px;height:52px;margin-bottom:16px" />
    @if (Model.Global)
    {
        <h1 style="font-size:19px">Nenhum cliente ainda</h1>
        <p class="sub" style="margin:8px 0 20px">Crie o primeiro cliente para começar a operar o canal.</p>
        <a class="acao" href="/admin/novo" style="display:inline-block;text-decoration:none;background:var(--ciano);color:#fff;border-radius:9px;padding:10px 18px;font-weight:600">Criar o primeiro cliente</a>
    }
    else
    {
        <h1 style="font-size:19px">Sem acesso a nenhum cliente</h1>
        <p class="sub" style="margin:8px 0 0">
            Seu usuário ainda não está atribuído a nenhum cliente. Peça a quem administra a
            plataforma para incluir seu acesso.
        </p>
    }
</div>
