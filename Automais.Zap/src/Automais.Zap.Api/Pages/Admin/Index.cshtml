@page "/admin"
@model Automais.Zap.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Painel";
}

<h1>Nenhum tenant</h1>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso">@Model.Erro</div>
}

<div class="cartao">
    @if (Model.Global)
    {
        <p class="sub" style="margin:0">
            Ainda não há nenhum cliente cadastrado. Use <strong>Novo tenant</strong>, no
            cabeçalho, para criar o primeiro.
        </p>
    }
    else
    {
        <p class="sub" style="margin:0">
            Você não está atribuído a nenhum tenant. Peça a quem administra a plataforma para
            incluir seu acesso.
        </p>
    }
</div>
