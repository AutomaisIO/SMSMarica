@page "/admin/atividade"
@model Automais.Zap.Api.Pages.Admin.AtividadeModel
@using Automais.Zap.Api.Pages.Admin
@{
    ViewData["Title"] = "Atividade";
}

@if (Model.Alvo is null)
{
    <div class="cartao vazio">Nenhum cliente selecionado.</div>
    return;
}

@section Head {
    <style>
        .legenda { display: flex; gap: 16px; align-items: center; font-size: 12px; color: var(--suave); margin: 2px 0 10px; }
        .legenda .item { display: flex; gap: 6px; align-items: center; }
        .legenda .cor { width: 10px; height: 10px; border-radius: 3px; }
        .barras-h { display: grid; gap: 8px; }
        .barras-h .linha-cat { display: grid; grid-template-columns: 170px 1fr 90px; gap: 12px; align-items: center; font-size: 13px; }
        .barras-h .trilho { background: var(--borda-suave); border-radius: 6px; height: 14px; overflow: hidden; }
        .barras-h .preenchido { background: #0899B8; height: 100%; border-radius: 0 6px 6px 0; min-width: 3px; }
        .barras-h .valor { text-align: right; }
        details.tabela-dados { margin-top: 10px; }
        details.tabela-dados > summary { cursor: pointer; font-size: 12px; color: var(--suave); user-select: none; }
    </style>
}

<div class="pagina-topo">
    <div>
        <h1>Atividade</h1>
        <p class="sub compacto">O movimento do canal de @Model.Alvo.Nome — na plataforma e nos números da Meta.</p>
    </div>
</div>

<div class="grade-resumo">
    <div class="resumo ok">
        <div class="valor">@AtividadeModel.FormatarInt(Model.Entregues7d)</div>
        <div class="rotulo">eventos entregues em 7 dias</div>
    </div>
    <div class="resumo @(Model.Falhas7d > 0 ? "alerta" : "")">
        <div class="valor">@Model.Falhas7d</div>
        <div class="rotulo">falhas em 7 dias</div>
    </div>
    <div class="resumo @(Model.SemRota7d > 0 ? "alerta" : "")">
        <div class="valor">@Model.SemRota7d</div>
        <div class="rotulo">sem rota em 7 dias</div>
    </div>
    <div class="resumo">
        <div class="valor">@Model.MediaMs7d<span class="fraco"> ms</span></div>
        <div class="rotulo">tempo médio de entrega</div>
    </div>
</div>

<h2>Entregas pela plataforma <span class="cont">últimos 14 dias</span></h2>
<div class="cartao">
    <div class="legenda"><span class="item"><span class="cor" style="background:#0899B8"></span> eventos entregues ao destino</span></div>
    @Model.Barras(Model.Dias.Select(d => (d.Data, d.Entregues)).ToList(), "#0899B8", "entregues")

    <div class="legenda" style="margin-top:16px"><span class="item"><span class="cor" style="background:#C93838"></span> falhas de entrega (escala própria)</span></div>
    @Model.Barras(Model.Dias.Select(d => (d.Data, d.Falhas)).ToList(), "#C93838", "falhas")

    <details class="tabela-dados">
        <summary>Ver como tabela</summary>
        <table style="margin-top:8px;max-width:480px">
            <thead><tr><th>Dia</th><th>Entregues</th><th>Falhas</th><th>Sem rota</th></tr></thead>
            <tbody>
            @foreach (var d in Enumerable.Reverse(Model.Dias))
            {
                <tr>
                    <td class="num">@d.Data.ToString("dd/MM")</td>
                    <td class="num">@AtividadeModel.FormatarInt(d.Entregues)</td>
                    <td class="num">@d.Falhas</td>
                    <td class="num">@d.SemRota</td>
                </tr>
            }
            </tbody>
        </table>
    </details>
</div>

@foreach (var w in Model.Wabas)
{
    <h2>Segundo a Meta — @w.Nome <span class="cont">últimos 30 dias</span></h2>
    <div class="cartao">
        @if (w.ErroMensagens is not null)
        {
            <div class="aviso atencao">A Meta não respondeu as métricas de mensagens: @w.ErroMensagens</div>
        }
        else if (w.Mensagens.Count == 0)
        {
            <p class="sub compacto">A Meta não reportou tráfego neste período.</p>
        }
        else
        {
            <div class="legenda">
                <span class="item"><span class="cor" style="background:#0899B8"></span> enviadas</span>
                <span class="item"><span class="cor" style="background:#7A2FE0"></span> entregues</span>
                <span style="margin-left:auto">total: @AtividadeModel.FormatarInt(w.Mensagens.Sum(p => p.Enviadas)) enviadas · @AtividadeModel.FormatarInt(w.Mensagens.Sum(p => p.Entregues)) entregues</span>
            </div>
            @Model.Linhas(w.Mensagens)
            <details class="tabela-dados">
                <summary>Ver como tabela</summary>
                <table style="margin-top:8px;max-width:480px">
                    <thead><tr><th>Dia</th><th>Enviadas</th><th>Entregues</th></tr></thead>
                    <tbody>
                    @foreach (var p in w.Mensagens.Reverse())
                    {
                        <tr>
                            <td class="num">@p.Inicio.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM")</td>
                            <td class="num">@AtividadeModel.FormatarInt(p.Enviadas)</td>
                            <td class="num">@AtividadeModel.FormatarInt(p.Entregues)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </details>
        }
    </div>

    <div class="cartao">
        <h3 style="margin-top:0">Mensagens cobradas e custo por categoria</h3>
        @if (w.ErroCobranca is not null)
        {
            <div class="aviso atencao">A Meta não respondeu as métricas de cobrança: @w.ErroCobranca</div>
        }
        else if (w.Cobranca.Count == 0)
        {
            <p class="sub compacto">Nenhuma mensagem cobrada reportada no período.</p>
        }
        else
        {
            var maxMensagens = Math.Max(1, w.Cobranca.Max(c => c.Mensagens));
            <div class="barras-h">
                @foreach (var c in w.Cobranca)
                {
                    <div class="linha-cat">
                        <span>@AtividadeModel.RotuloCategoria(c.Categoria)</span>
                        <span class="trilho"><span class="preenchido" style="width:@(Math.Max(1, 100.0 * c.Mensagens / maxMensagens).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        <span class="valor num">@AtividadeModel.FormatarInt(c.Mensagens)</span>
                    </div>
                }
            </div>
            <table style="margin-top:14px;max-width:480px">
                <thead><tr><th>Categoria</th><th>Mensagens</th><th>Custo@(w.Moeda is null ? "" : $" ({w.Moeda})")</th></tr></thead>
                <tbody>
                @foreach (var c in w.Cobranca)
                {
                    <tr>
                        <td>@AtividadeModel.RotuloCategoria(c.Categoria)</td>
                        <td class="num">@AtividadeModel.FormatarInt(c.Mensagens)</td>
                        <td class="num">@c.Custo.ToString("N4", new System.Globalization.CultureInfo("pt-BR"))</td>
                    </tr>
                }
                <tr>
                    <td><strong>Total</strong></td>
                    <td class="num"><strong>@AtividadeModel.FormatarInt(w.Cobranca.Sum(c => c.Mensagens))</strong></td>
                    <td class="num"><strong>@w.Cobranca.Sum(c => c.Custo).ToString("N4", new System.Globalization.CultureInfo("pt-BR"))</strong></td>
                </tr>
                </tbody>
            </table>
            <p class="ajuda-campo" style="margin-top:10px">
                Valores que a própria Meta reporta (modelo por mensagem, vigente desde julho/2025),
                na moeda de cobrança do WABA. A fatura oficial continua sendo a da Meta.
            </p>
        }
    </div>
}

@if (Model.Wabas.Count == 0)
{
    <div class="cartao vazio">Nenhum WABA vinculado ainda — as métricas da Meta aparecem aqui quando houver.</div>
}
