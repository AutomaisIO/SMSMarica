<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SMSMarica.Secretario.Api</RootNamespace>
    <AssemblyName>SMSMarica.Secretario.Api</AssemblyName>
    <!-- Rótulos de mês em pt-BR ("julho/2026") dependem de ICU completo. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Projeto fora do CPM do SMSMarica.server — versão declarada aqui, mesma do server. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
