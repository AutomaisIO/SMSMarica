# /etc/pacs-monitor.env no servidor do PACS (chmod 600). A chave é a MESMA do env do servidor da
# plataforma (AlertaPlataforma__ChaveMonitorExterno em /etc/smsmarica-server/env) e nunca entra
# no repositório. Gerar com: openssl rand -hex 32
PACS_MONITOR_URL=https://api.smsmarica.online/alertas-plataforma/externo
PACS_MONITOR_CHAVE=

# Opcionais (valores padrão):
# PACS_MONITOR_TOLERANCIA_S=120          falha contínua antes de avisar
# PACS_MONITOR_DIRETA_ALERTA_PCT=80      memória direta do Java (% do limite) que já é alerta
# PACS_MONITOR_DIRETA_INTERVALO_S=600    de quanto em quanto lê a memória do Java (custa ~5 s de CPU)
# PACS_MONITOR_HOST_LIVRE_MIN_MB=120     memória livre do host abaixo disto = alerta
# PACS_MONITOR_REINICIO_ESPERA_S=300     quanto o restart programado espera o PACS voltar
